# ── docker-compose overrides (all optional) ─────────────────────────────
# Copy to .env next to docker-compose.yml to override the baked-in
# defaults. `docker compose up --build` works without this file.

# Password of the compose Postgres (user `bank`, db `bank`).
POSTGRES_PASSWORD=bank

# Seeded admin login for the auth API. Idempotent: once the admin user
# exists, changing these does NOT update it (wipe the pgdata volume to
# re-seed).
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin

# JWT claims shared by auth-api (signing) and app-apis (verifying).
JWT_ISSUER=bank-auth
JWT_AUDIENCE=bank-internal-api
JWT_TTL_SECONDS=3600

# Host port of the nginx gateway — the single entry point for all services.
GATEWAY_PORT=3000

# Log level for all services.
LOG_LEVEL=info

# Comma-separated CORS allowlist for both APIs (empty = deny all).
CORS_ALLOWED_ORIGINS=

# ── Vehicle telemetry (see docs/TELEMETRY.md) ───────────────────────────
# Host port the vehicles' Teltonika devices connect to. Published directly:
# the protocol is binary TCP, so it does not go through the nginx gateway.
TELEMETRY_TCP_PORT=5027

# Host-side Kafka listener, so the telemetry apps can run from source
# (pnpm dev) or the integration tests can reuse this broker.
KAFKA_HOST_PORT=29092

# Topic retention — the window in which a consumer that was down can still
# catch up on what it missed. Offsets are retained longer (see compose), so
# a long outage keeps its place as well as its backlog.
TELEMETRY_RETENTION_MS=604800000
KAFKA_OFFSETS_RETENTION_MINUTES=20160

# A record older than this on arrival came from a device's flash buffer and
# goes to the backfill topic instead of the live one.
BACKFILL_THRESHOLD_MS=300000

# Drop a device connection that has gone silent for this long.
IDLE_TIMEOUT_MS=300000

# Which telemetry consumers run: "all", or a subset of
# locations,fuel,engine,alerting.
CONSUMERS=all

# Alert thresholds and edge-trigger behaviour.
LOW_FUEL_PCT=15
SPEED_LIMIT_KPH=90
ALERT_COOLDOWN_MS=900000
ALERT_MAX_AGE_MS=600000
GEOFENCE_REFRESH_MS=60000
