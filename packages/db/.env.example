# ── Database package (@bank/db) ─────────────────────────────────────────
# Copy to packages/db/.env for local development (pnpm db:migrate).
# docker-compose provides all of these automatically.

# Postgres connection string to migrate + seed.
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# Seeded admin login. Idempotent: once the admin exists, changing these
# does NOT update it.
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin
