# ── Telemetry database (separate cluster) ───────────────────────────────
# Copy to packages/db-telemetry/.env for `pnpm db:generate` / `pnpm db:migrate`.
# docker-compose provides this automatically.

# Telemetry lives on its own Postgres instance, not just its own database:
# it keeps the banking cluster small enough to back up and replicate quickly,
# and stops a telemetry write storm from touching the disk holding transfers.
# Note the port differs from the banking cluster's 5432.
TELEMETRY_DATABASE_URL=postgres://bank:bank@localhost:5433/bank_telemetry
