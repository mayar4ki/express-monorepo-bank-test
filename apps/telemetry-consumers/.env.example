# ── Telemetry Consumers (Kafka → Postgres + alerts) ─────────────────────
# Copy to apps/telemetry-consumers/.env for local development (pnpm dev).
# docker-compose provides all of these automatically.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for the tiny /health endpoint (reports each consumer's liveness).
PORT=3004

# Pino log level: fatal | error | warn | info | debug | trace | silent
# Alerts are logged at warn.
LOG_LEVEL=info

# Postgres connection string — telemetry rows and alerts are written here.
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# Comma-separated Kafka brokers. Inside compose this is kafka:9092; from the
# host use the broker's host listener (see KAFKA_HOST_PORT in compose).
KAFKA_BROKERS=localhost:29092

# Client id this service reports to the broker.
KAFKA_CLIENT_ID=telemetry-consumers

# Which consumers this process runs: "all", or a comma-separated subset of
# locations,fuel,engine,alerting. Each has its own consumer group and offsets,
# so narrowing this is all it takes to split one into its own deployment.
CONSUMERS=all

# ── Alert rules ─────────────────────────────────────────────────────────
# Fire a low-fuel alert below this percentage.
LOW_FUEL_PCT=15

# Fire a speeding alert above this speed.
SPEED_LIMIT_KPH=90

# Alerts are edge-triggered: one row when a condition starts holding, then not
# again until this has elapsed while it continues to hold.
ALERT_COOLDOWN_MS=900000

# Never alert on a reading older than this. Alerting already reads only the
# live topic; this is the backstop for a device with a badly wrong clock.
ALERT_MAX_AGE_MS=600000

# How often the active geofences are reloaded from the database.
GEOFENCE_REFRESH_MS=60000
