# ── Banking API (app-apis) ──────────────────────────────────────────────
# Copy to apps/app-apis/.env for local development (pnpm dev).
# docker-compose provides all of these automatically.
# Swagger UI: http://localhost:3000/docs (spec at /docs/openapi.json)

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string (the compose postgres uses bank/bank/bank).
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# Redis connection string — backs the BullMQ transfers queue.
REDIS_URL=redis://localhost:6379

# Where to fetch the auth API's public signing keys (JWKS). Tokens are
# verified against these keys, so this must point at the running auth-api.
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# Expected `iss` / `aud` claims — must match the auth API's JWT_ISSUER
# and JWT_AUDIENCE, otherwise every token is rejected.
AUTH_ISSUER=bank-auth
AUTH_AUDIENCE=bank-internal-api

# Comma-separated list of origins allowed to make cross-origin requests.
# Leave empty to deny all cross-origin access (recommended default).
CORS_ALLOWED_ORIGINS=

# Comma-separated URLs of other services' OpenAPI specs to merge into /docs.
# Behind the gateway this makes the whole platform document as one API.
# Leave empty to document only this service.
DOCS_MERGE_SPEC_URLS=http://localhost:3001/docs/openapi.json
