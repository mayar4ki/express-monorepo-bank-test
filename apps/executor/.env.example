# ── Transfer Executor (worker) ──────────────────────────────────────────
# Copy to apps/executor/.env for local development (pnpm dev).
# docker-compose provides all of these automatically.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for the tiny /health endpoint (no other HTTP surface).
PORT=3002

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string — transfers execute in DB transactions here.
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# Redis connection string — the BullMQ queue this worker consumes.
REDIS_URL=redis://localhost:6379
