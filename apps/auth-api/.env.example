# ── Auth API (auth-api) ─────────────────────────────────────────────────
# Copy to apps/auth-api/.env for local development (pnpm dev).
# docker-compose provides all of these automatically.

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3001

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string (shared with the other services).
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# JWT signing key: an ES256 private key in PKCS8 PEM format.
# Priority: JWT_PRIVATE_KEY_FILE (path) > JWT_PRIVATE_KEY (inline PEM).
# If neither is set outside production, an ephemeral key is generated at
# boot (all tokens die on restart). Production REQUIRES one of these.
# Generate one with: pnpm --filter @bank/auth-api generate-dev-key
JWT_PRIVATE_KEY_FILE=./dev/jwt-dev-es256.pem
#JWT_PRIVATE_KEY=

# Claims stamped into issued tokens. Resource APIs (app-apis) must be
# configured with the same values (AUTH_ISSUER / AUTH_AUDIENCE).
JWT_ISSUER=bank-auth
JWT_AUDIENCE=bank-internal-api

# Token lifetime in seconds (default 1 hour).
JWT_TTL_SECONDS=3600

# Comma-separated list of origins allowed to make cross-origin requests.
# Leave empty to deny all cross-origin access (recommended default).
CORS_ALLOWED_ORIGINS=
