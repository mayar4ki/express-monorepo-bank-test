# ── Telemetry Ingest (Teltonika TCP listener) ───────────────────────────
# Copy to apps/telemetry-ingest/.env for local development (pnpm dev).
# docker-compose provides all of these automatically.

# Runtime mode: development | test | production
NODE_ENV=development

# Port for the tiny /health endpoint (no other HTTP surface).
PORT=3003

# Where the vehicles' devices connect. Raw TCP, Codec 8 / 8E — this is not
# HTTP, so it does not go through the nginx gateway.
TCP_PORT=5027

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated Kafka brokers. Inside compose this is kafka:9092; from the
# host use the broker's host listener (see KAFKA_HOST_PORT in compose).
KAFKA_BROKERS=localhost:29092

# Client id this service reports to the broker.
KAFKA_CLIENT_ID=telemetry-ingest

# Drop a device connection that has gone silent for this long. Devices report
# every minute or two and hold the connection open in between.
IDLE_TIMEOUT_MS=300000

# A record older than this when it reaches us came out of the device's flash
# buffer rather than off the wire live, and goes to the backfill topic so a
# reconnecting vehicle's backlog cannot delay live data. See docs/TELEMETRY.md.
BACKFILL_THRESHOLD_MS=300000
